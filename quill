#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
QUILLMIT_VERSION="dev"
if [[ -f "$SCRIPT_DIR/VERSION" ]]; then
  QUILLMIT_VERSION="$(tr -d '[:space:]' < "$SCRIPT_DIR/VERSION")"
fi

usage() {
  cat <<'TEXT'
Usage:
  quill [-a|-c|-p|-f] [--codex|--claude|--gemini|--provider name] [--config file] [--prepare|--commit|--copy|--quit|--add|--push|--full|--verbose|--version] [repo]
  quill worktree create [intent] [--branch name] [--from ref] [--remote name] [--no-preview] [--repo path]
  quill worktree list [--repo path]
  quill worktree remove [name|path] [--repo path]
  quill pr [--remote name] [--base branch] [--no-preview] [--codex|--claude|--gemini|--provider name] [--config file] [--verbose] [repo]

Generate a medium-sized Git commit message, prepare it, then choose an action.
Use "quill pr" to select a remote base branch and create a pull request.
Use --remote and --base to skip PR selection; --no-preview approves creation.
Worktree creation also accepts provider flags. --branch supplies a name without AI.
Use --from for a local starting ref; without a remote, --from is required.
Without a removal target, Quillmit selects the current linked worktree.
Worktree removal preserves branches and refuses files or commits at risk.
TEXT
}

WORKFLOW="commit"
MODE="interactive"
REPO_INPUT=""
VERBOSE=0
ADD_ALL=0
PUSH_AFTER_COMMIT=0
FULL_REQUESTED=0
NON_COMMIT_MODE_FLAGS=""
PROVIDER=""
CONFIG_FILE="$SCRIPT_DIR/quill.config"
PR_REMOTE_INPUT=""
PR_BASE_INPUT=""
PR_NO_PREVIEW=0
WT_ACTION=""
WT_INPUT=""
WT_FROM=""
WT_BRANCH=""
WT_REMOTE=""

DEFAULT_PROVIDER=codex
CODEX_MODEL=gpt-5.3-codex-spark
CODEX_REASONING_EFFORT=""
CODEX_FALLBACK_MODEL=gpt-5.6-luna
CODEX_FALLBACK_REASONING_EFFORT=low
CLAUDE_MODEL=haiku
CLAUDE_FALLBACK_MODEL=haiku
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
CODEX_MAX_PROMPT_BYTES=160000
CLAUDE_MAX_PROMPT_BYTES=160000
GEMINI_MAX_PROMPT_BYTES=160000

if [[ "${1:-}" == worktree ]]; then
  WORKFLOW=worktree
  shift
  WT_ACTION="${1:-list}"
  [[ "$WT_ACTION" != --help && "$WT_ACTION" != -h ]] || { usage; exit 0; }
  [[ $# -eq 0 ]] || shift
fi

if [[ "$WORKFLOW" == commit && "${1:-}" == "pr" ]]; then
  WORKFLOW="pr"
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from|--branch|--repo)
      [[ "$WORKFLOW" == worktree && $# -ge 2 && -n "$2" && "$2" != -* ]] || { print -u2 -- "$1 requires a value and is only available with quill worktree."; exit 1; }
      case "$1" in
        --from) WT_FROM="$2" ;;
        --branch) WT_BRANCH="$2" ;;
        --repo) REPO_INPUT="$2" ;;
      esac
      shift 2 ;;
    --remote|--base)
      if [[ "$WORKFLOW" == worktree && "$1" == --remote ]]; then
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || { print -u2 -- "--remote requires a name."; exit 1; }
        WT_REMOTE="$2"
        shift 2
        continue
      fi
      if [[ "$WORKFLOW" != "pr" || $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        print -u2 -- "$1 requires a value and is only available with quill pr."
        exit 1
      fi
      if [[ "$1" == "--remote" ]]; then PR_REMOTE_INPUT="$2"; else PR_BASE_INPUT="$2"; fi
      shift 2
      ;;
    --no-preview)
      [[ "$WORKFLOW" == "pr" || "$WORKFLOW" == worktree ]] || { print -u2 -- "--no-preview is only available with quill pr or worktree create."; exit 1; }
      PR_NO_PREVIEW=1
      shift
      ;;
    --prepare)
      MODE="prepare"
      NON_COMMIT_MODE_FLAGS="${NON_COMMIT_MODE_FLAGS:+$NON_COMMIT_MODE_FLAGS }--prepare"
      shift
      ;;
    -c|--yes|--commit)
      MODE="commit"
      shift
      ;;
    --copy)
      MODE="copy"
      NON_COMMIT_MODE_FLAGS="${NON_COMMIT_MODE_FLAGS:+$NON_COMMIT_MODE_FLAGS }--copy"
      shift
      ;;
    --quit)
      MODE="quit"
      NON_COMMIT_MODE_FLAGS="${NON_COMMIT_MODE_FLAGS:+$NON_COMMIT_MODE_FLAGS }--quit"
      shift
      ;;
    --verbose)
      VERBOSE=1
      shift
      ;;
    -a|--add)
      ADD_ALL=1
      shift
      ;;
    -p|--push)
      PUSH_AFTER_COMMIT=1
      shift
      ;;
    -f|--full)
      ADD_ALL=1
      PUSH_AFTER_COMMIT=1
      FULL_REQUESTED=1
      MODE="commit"
      shift
      ;;
    --codex)
      PROVIDER="codex"
      shift
      ;;
    --claude)
      PROVIDER="claude"
      shift
      ;;
    --gemini)
      PROVIDER="gemini"
      shift
      ;;
    --provider)
      PROVIDER="${2:-}"
      shift 2
      ;;
    --config)
      CONFIG_FILE="${2:-}"
      shift 2
      ;;
    --version)
      print -- "quill $QUILLMIT_VERSION"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ "$WORKFLOW" == worktree ]]; then
        [[ "$1" != -* && -z "$WT_INPUT" ]] || { print -u2 -- "Unknown argument: $1. Quote the worktree intent as one argument."; exit 1; }
        WT_INPUT="$1"
      else
        REPO_INPUT="$1"
      fi
      shift
      ;;
  esac
done

if [[ "$WORKFLOW" != "commit" && ( "$MODE" != "interactive" || "$ADD_ALL" -eq 1 || "$PUSH_AFTER_COMMIT" -eq 1 ) ]]; then
  print -u2 -- "Commit workflow flags cannot be combined with quill $WORKFLOW."
  exit 1
fi

if [[ "$PUSH_AFTER_COMMIT" -eq 1 && -n "$NON_COMMIT_MODE_FLAGS" ]]; then
  local_flag="${NON_COMMIT_MODE_FLAGS%% *}"
  if [[ "$FULL_REQUESTED" -eq 1 ]]; then
    print -u2 -- "--full cannot be combined with $local_flag"
  else
    print -u2 -- "--push cannot be combined with $local_flag"
  fi
  exit 1
fi

if [[ -n "$CONFIG_FILE" && -f "$CONFIG_FILE" ]]; then
  source "$CONFIG_FILE"
fi

if [[ -z "$PROVIDER" ]]; then
  PROVIDER="$DEFAULT_PROVIDER"
fi

case "$PROVIDER" in
  codex|claude|gemini) ;;
  *)
    print -u2 -- "Unknown provider: $PROVIDER"
    exit 1
    ;;
esac

provider_label() {
  case "$PROVIDER" in
    codex) print -- "Codex" ;;
    claude) print -- "Claude" ;;
    gemini) print -- "Gemini" ;;
  esac
}

provider_command() {
  case "$PROVIDER" in
    codex) print -- "codex" ;;
    claude) print -- "claude" ;;
    gemini) print -- "gemini" ;;
  esac
}

provider_model() {
  case "$PROVIDER" in
    codex) print -- "$CODEX_MODEL" ;;
    claude) print -- "$CLAUDE_MODEL" ;;
    gemini) print -- "$GEMINI_MODEL" ;;
  esac
}

provider_fallback_model() {
  case "$PROVIDER" in
    codex) print -- "$CODEX_FALLBACK_MODEL" ;;
    claude) print -- "$CLAUDE_FALLBACK_MODEL" ;;
    gemini) print -- "$GEMINI_FALLBACK_MODEL" ;;
  esac
}

provider_max_prompt_bytes() {
  case "$PROVIDER" in
    codex) print -- "$CODEX_MAX_PROMPT_BYTES" ;;
    claude) print -- "$CLAUDE_MAX_PROMPT_BYTES" ;;
    gemini) print -- "$GEMINI_MAX_PROMPT_BYTES" ;;
  esac
}

SELECTED_OPTION=""
FZF="$SCRIPT_DIR/.deps/fzf/fzf"

tui_fzf() {
  # User fzf defaults must not change selection or bypass approval.
  FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE= SHELL=/bin/sh "$FZF" \
    --layout=reverse --border=rounded --no-multi "$@"
}

select_option() {
  local prompt="$1"
  shift
  local -a options=("$@")
  local result

  if [[ "${#options[@]}" -eq 0 ]]; then
    print -u2 -- "No options are available for $prompt."
    return 1
  fi

  if SELECTED_OPTION="$(print -rl -- "${options[@]}" | tui_fzf \
    --border-label=" Quillmit | $prompt " --prompt='Filter > ' \
    --header=$'Type to filter | Up/Down or click to select\nEnter or double-click: continue | Esc: cancel' \
    --bind='esc:abort,ctrl-c:abort,ctrl-g:abort,double-click:accept')"; then
    return 0
  else
    result=$?
    if [[ "$result" -eq 130 ]]; then
      print -- "Pull request cancelled."
      exit 0
    fi
    print -u2 -- "Branch selection failed (exit $result)."
    return "$result"
  fi
}

select_pr_base() {
  local -a remotes
  remotes=("${(@f)$(git -C "$REPO" remote)}")
  if [[ "${#remotes[@]}" -eq 0 ]]; then
    print -u2 -- "No Git remote is configured."
    return 1
  fi

  if [[ -n "$PR_REMOTE_INPUT" ]]; then
    if [[ "${remotes[(Ie)$PR_REMOTE_INPUT]}" -eq 0 ]]; then
      print -u2 -- "Unknown remote: $PR_REMOTE_INPUT"
      return 1
    fi
    PR_BASE_REMOTE="$PR_REMOTE_INPUT"
  elif [[ "${#remotes[@]}" -eq 1 ]]; then
    PR_BASE_REMOTE="${remotes[1]}"
    print -- "Using base remote: $PR_BASE_REMOTE"
  else
    select_option "Select the pull request base remote:" "${remotes[@]}"
    PR_BASE_REMOTE="$SELECTED_OPTION"
  fi

  print -- "Fetching branches from $PR_BASE_REMOTE..."
  git -C "$REPO" fetch --prune "$PR_BASE_REMOTE"

  local default_ref
  local default_branch
  local branch
  local -a discovered_branches
  default_ref="$(git -C "$REPO" symbolic-ref --quiet --short "refs/remotes/$PR_BASE_REMOTE/HEAD" 2>/dev/null || true)"
  default_branch="${default_ref#"$PR_BASE_REMOTE/"}"
  discovered_branches=("${(@f)$(git -C "$REPO" for-each-ref --format='%(refname:strip=3)' "refs/remotes/$PR_BASE_REMOTE")}")

  discovered_branches=("${(@on)discovered_branches}")
  local -a branches
  if [[ -n "$default_branch" ]]; then
    branches+=("$default_branch")
  fi
  for branch in "${discovered_branches[@]}"; do
    [[ "$branch" == "HEAD" || "$branch" == "$default_branch" ]] && continue
    branches+=("$branch")
  done

  if [[ -n "$PR_BASE_INPUT" ]]; then
    if [[ "${branches[(Ie)$PR_BASE_INPUT]}" -eq 0 || "$PR_BASE_INPUT" == HEAD ]]; then
      print -u2 -- "Unknown base branch on $PR_BASE_REMOTE: $PR_BASE_INPUT"
      return 1
    fi
    PR_BASE_BRANCH="$PR_BASE_INPUT"
  else
    select_option "Select the pull request base branch on $PR_BASE_REMOTE:" "${branches[@]}"
    PR_BASE_BRANCH="$SELECTED_OPTION"
  fi
  PR_BASE_REF="refs/remotes/$PR_BASE_REMOTE/$PR_BASE_BRANCH"
  PR_BASE_URL="$(git -C "$REPO" remote get-url "$PR_BASE_REMOTE")"

  if ! PR_BASE_REPO="$(gh repo view "$PR_BASE_URL" --json nameWithOwner --jq .nameWithOwner)"; then
    print -u2 -- "The selected base remote is not available through GitHub CLI: $PR_BASE_REMOTE"
    return 1
  fi
}

setup_pr_context() {
  local needs_tui=0
  [[ -z "$PR_BASE_INPUT" || "$PR_NO_PREVIEW" -eq 0 ]] && needs_tui=1
  if [[ -z "$PR_REMOTE_INPUT" && "$(git -C "$REPO" remote | wc -l)" -gt 1 ]]; then
    needs_tui=1
  fi
  if [[ "$needs_tui" -eq 1 ]]; then
    if [[ ! -t 0 || ! -t 1 ]]; then
      print -u2 -- "quill pr requires a terminal unless --base and --no-preview are set (also --remote when multiple remotes exist)."
      return 1
    fi
    if [[ ! -x "$FZF" ]]; then
      print -u2 -- "Quillmit's TUI dependency is missing. Run ./scripts/setup-deps in the source checkout, or reinstall Quillmit."
      return 1
    fi
  fi
  if ! command -v gh >/dev/null 2>&1; then
    print -u2 -- "GitHub CLI not found in PATH: gh"
    return 1
  fi

  if ! PR_HEAD_BRANCH="$(git -C "$REPO" symbolic-ref --quiet --short HEAD)"; then
    print -u2 -- "Cannot create a pull request from a detached HEAD."
    return 1
  fi

  while true; do
    select_pr_base
    [[ "$(git -C "$REPO" rev-list --count "$PR_BASE_REF..HEAD")" -gt 0 ]] && break
    print -u2 -- "No commits exist between $PR_BASE_REMOTE/$PR_BASE_BRANCH and $PR_HEAD_BRANCH."
    [[ -n "$PR_BASE_INPUT" ]] && return 1
    print -- "Choose another base branch."
  done

  CONTEXT_MODE="committed pull request changes"
  OUTPUT_NAME="pull request title and description"
}

if [[ -z "$REPO_INPUT" ]]; then
  REPO_INPUT="$PWD"
fi

if [[ ! -d "$REPO_INPUT" ]]; then
  print -u2 -- "Not a directory: $REPO_INPUT"
  exit 1
fi

REPO="$(git -C "$REPO_INPUT" rev-parse --show-toplevel 2>/dev/null)" || {
  print -u2 -- "Not inside a Git repository: $REPO_INPUT"
  exit 1
}

OUTPUT_NAME="commit message"
if [[ "$WORKFLOW" == "pr" ]]; then
  setup_pr_context
elif [[ "$WORKFLOW" == worktree ]]; then
  OUTPUT_NAME="worktree proposal"
else
  if [[ -z "$(git -C "$REPO" status --short)" ]]; then
    print -- "No changes to commit in $REPO"
    exit 0
  fi

  if [[ "$ADD_ALL" -eq 1 ]]; then
    git -C "$REPO" add -A
  fi

  if [[ -n "$(git -C "$REPO" diff --cached --name-only)" ]]; then
    CONTEXT_MODE="staged changes only"
  else
    CONTEXT_MODE="all changed files"
  fi
fi

CLI="$(provider_command)"
MODEL="$(provider_model)"
FALLBACK_MODEL="$(provider_fallback_model)"
MAX_PROMPT_BYTES="$(provider_max_prompt_bytes)"
LABEL="$(provider_label)"

if [[ ! "$MAX_PROMPT_BYTES" =~ '^[0-9]+$' || "$MAX_PROMPT_BYTES" -lt 20000 ]]; then
  print -u2 -- "Invalid ${PROVIDER:u}_MAX_PROMPT_BYTES: $MAX_PROMPT_BYTES (expected an integer of at least 20000)"
  exit 1
fi

if [[ "$WORKFLOW" != worktree || ( "$WT_ACTION" == create && -z "$WT_BRANCH" ) ]] && ! command -v "$CLI" >/dev/null 2>&1; then
  print -u2 -- "$LABEL CLI not found in PATH: $CLI"
  exit 1
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/quill.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT
MESSAGE_FILE="$TMP_DIR/message.txt"
PROMPT_FILE="$TMP_DIR/prompt.txt"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/quill"
LOG_FILE="$LOG_DIR/last.log"
if ! { mkdir -p "$LOG_DIR" && : > "$LOG_FILE"; } 2>/dev/null; then
  LOG_DIR="${TMPDIR:-/tmp}/quill"
  mkdir -p "$LOG_DIR"
  LOG_FILE="$LOG_DIR/last.log"
  : > "$LOG_FILE"
fi
PROGRESS_PID=""
PROGRESS_FILE="$TMP_DIR/progress"
FALLBACK_USED_FILE="$TMP_DIR/provider-fallback-used"
PROGRESS_TOTAL=1
PROGRESS_WIDTH=24
BATCH_COUNT=0
BATCH_FILE_COUNT=0
BATCH_CONTENT_BYTES=$((MAX_PROMPT_BYTES - 12000))

write_output_requirements() {
  if [[ "$WORKFLOW" == "pr" ]]; then
    print -- "Return only the pull request title and description."
    print -- "Put the title on the first line, then one blank line, then the Markdown description."
    print -- ""
    print -- "Requirements:"
    print -- "- Write a concise title that describes the complete branch change."
    print -- "- Do not use conventional commit prefixes such as feat:, fix:, chore:, docs:, refactor:, or test:."
    print -- "- Explain the intent and important behavior in the description."
    print -- "- Use concise Markdown sections or bullets when they improve clarity."
    print -- "- Do not invent validation results, issue links, risks, or implementation details."
    print -- "- Do not wrap the response in quotes or an outer Markdown code fence."
    return
  fi

  print -- "Return only the commit message text."
  print -- ""
  print -- "Requirements:"
  print -- "- Use a clear, normal title by default."
  print -- "- Do not use conventional commit prefixes such as feat:, feat(scope):, fix:, chore:, docs:, refactor:, or test:."
  print -- "- Bad: feat(pipeline): add telemetry"
  print -- "- Bad: chore: update release scripts"
  print -- "- Good: Add run-profile telemetry for compile/update orchestration"
  print -- "- Good, only when the type is obvious: Feature: Add run-profile telemetry for compile/update orchestration"
  print -- "- Good, only for an obvious defect repair: Bug: Fix route-health status reporting"
  print -- "- Make it medium length: one title line, a blank line, then 2-4 concise body lines or sentences."
  print -- "- Mention the actual intent of the diff, not a mechanical file list."
  print -- "- Do not wrap the answer in Markdown or quotes."
}

write_git_overview() {
  print -- "Repository:"
  print -- "$REPO"
  print -- ""
  print -- "Context mode: $CONTEXT_MODE"
  print -- ""
  if [[ "$WORKFLOW" == "pr" ]]; then
    print -- "Base repository: $PR_BASE_REPO"
    print -- "Base branch: $PR_BASE_REMOTE/$PR_BASE_BRANCH"
    print -- "Head branch: $PR_HEAD_BRANCH"
    print -- ""
    print -- "Commits in the pull request:"
    git -C "$REPO" log --format='- %h %s' "$PR_BASE_REF..HEAD"
    print -- ""
    print -- "Pull request diff --stat:"
    git -C "$REPO" diff --no-ext-diff --stat "$PR_BASE_REF...HEAD"
  elif [[ "$CONTEXT_MODE" == "staged changes only" ]]; then
    print -- "Staged files:"
    git -C "$REPO" diff --cached --name-status
    print -- ""
    print -- "Staged diff --stat:"
    git -C "$REPO" diff --cached --stat
  else
    print -- "Git status --short:"
    git -C "$REPO" status --short
    print -- ""
    print -- "Unstaged diff --stat:"
    git -C "$REPO" diff --stat
    print -- ""
    print -- "Untracked files:"
    git -C "$REPO" ls-files --others --exclude-standard
  fi
}

write_diff() {
  if [[ "$WORKFLOW" == "pr" ]]; then
    git -C "$REPO" diff --no-ext-diff "$PR_BASE_REF...HEAD" "$@"
  elif [[ "$CONTEXT_MODE" == "staged changes only" ]]; then
    git -C "$REPO" diff --cached --no-ext-diff "$@"
  else
    git -C "$REPO" diff --no-ext-diff "$@"
  fi
}

write_changed_file_names() {
  if [[ "$WORKFLOW" == "pr" ]]; then
    git -C "$REPO" diff --no-ext-diff --name-only -z "$PR_BASE_REF...HEAD"
  elif [[ "$CONTEXT_MODE" == "staged changes only" ]]; then
    git -C "$REPO" diff --cached --name-only -z
  else
    git -C "$REPO" diff --name-only -z
  fi
}

write_git_context() {
  {
    if [[ "$WORKFLOW" == "pr" ]]; then
      print -- "Generate a pull request title and description from the committed Git changes below."
    else
      print -- "Generate a git commit message from the Git context below."
    fi
    print -- ""
    print -- "Do not inspect the repository yourself. Do not run commands. Do not modify files. Do not stage files. Do not commit."
    print -- ""
    write_output_requirements
    print -- ""
    write_git_overview
    print -- ""
    if [[ "$WORKFLOW" == "pr" ]]; then
      print -- "Pull request diff:"
      write_diff
    elif [[ "$CONTEXT_MODE" == "staged changes only" ]]; then
      print -- "Staged diff:"
      write_diff
    else
      print -- "Unstaged diff:"
      write_diff
    fi
  } > "$PROMPT_FILE"
}

new_batch() {
  BATCH_COUNT=$((BATCH_COUNT + 1))
  CURRENT_BATCH_FILE="$TMP_DIR/batch-$BATCH_COUNT.diff"
  CURRENT_BATCH_BYTES=0
  : > "$CURRENT_BATCH_FILE"
}

append_batch_unit() {
  local unit_file="$1"
  local label="$2"
  local unit_bytes
  unit_bytes="$(wc -c < "$unit_file" | tr -d ' ')"

  if [[ "$CURRENT_BATCH_BYTES" -gt 0 && $((CURRENT_BATCH_BYTES + unit_bytes + 80)) -gt "$BATCH_CONTENT_BYTES" ]]; then
    new_batch
  fi

  print -- "" >> "$CURRENT_BATCH_FILE"
  print -- "--- $label ---" >> "$CURRENT_BATCH_FILE"
  cat "$unit_file" >> "$CURRENT_BATCH_FILE"
  CURRENT_BATCH_BYTES="$(wc -c < "$CURRENT_BATCH_FILE" | tr -d ' ')"
}

append_oversized_diff() {
  local diff_file="$1"
  local file="$2"
  local split_dir="$TMP_DIR/split-$BATCH_COUNT-${RANDOM}"
  local header
  local header_bytes
  local piece_bytes
  local part=0
  local found_hunk=0
  local hunk
  local combined
  local combined_bytes
  local piece_prefix
  local piece
  local combined_piece
  mkdir -p "$split_dir"

  LC_ALL=C awk -v dir="$split_dir" '
    function output() { return sprintf("%s/hunk-%06d.diff", dir, part) }
    /^@@ / { if (started) close(output()); part++; started=1 }
    { print >> output() }
  ' "$diff_file"

  header="$split_dir/hunk-000000.diff"
  header_bytes="$(wc -c < "$header" | tr -d ' ')"
  piece_bytes=$((BATCH_CONTENT_BYTES - header_bytes - 200))
  if [[ "$piece_bytes" -lt 1000 ]]; then
    piece_bytes=$((BATCH_CONTENT_BYTES / 2))
  fi

  for hunk in "$split_dir"/hunk-*.diff; do
    [[ -f "$hunk" ]] || continue
    [[ "$hunk" == "$header" ]] && continue
    found_hunk=1
    combined="$split_dir/combined-${part}.diff"
    cat "$header" "$hunk" > "$combined"
    combined_bytes="$(wc -c < "$combined" | tr -d ' ')"
    if [[ "$combined_bytes" -le "$BATCH_CONTENT_BYTES" ]]; then
      part=$((part + 1))
      append_batch_unit "$combined" "File: $file (part $part)"
      continue
    fi

    piece_prefix="$split_dir/piece-${part}-"
    split -b "$piece_bytes" -a 6 "$hunk" "$piece_prefix"
    for piece in "$piece_prefix"*; do
      part=$((part + 1))
      combined_piece="$split_dir/combined-piece-${part}.diff"
      cat "$header" "$piece" > "$combined_piece"
      append_batch_unit "$combined_piece" "File: $file (part $part)"
    done
  done

  if [[ "$found_hunk" -eq 0 ]]; then
    piece_prefix="$split_dir/header-piece-"
    split -b "$BATCH_CONTENT_BYTES" -a 6 "$header" "$piece_prefix"
    for piece in "$piece_prefix"*; do
      part=$((part + 1))
      append_batch_unit "$piece" "File: $file (part $part)"
    done
  fi
}

build_batches() {
  BATCH_COUNT=0
  BATCH_FILE_COUNT=0
  new_batch

  local file_index=0
  local file
  local diff_file
  local diff_bytes
  while IFS= read -r -d '' file; do
    file_index=$((file_index + 1))
    diff_file="$TMP_DIR/file-$file_index.diff"
    write_diff -- "$file" > "$diff_file"
    diff_bytes="$(wc -c < "$diff_file" | tr -d ' ')"
    if [[ "$diff_bytes" -gt "$BATCH_CONTENT_BYTES" ]]; then
      append_oversized_diff "$diff_file" "$file"
    else
      append_batch_unit "$diff_file" "File: $file"
    fi
  done < <(write_changed_file_names)
  BATCH_FILE_COUNT="$file_index"
}

write_batch_prompts() {
  local batch
  for ((batch = 1; batch <= BATCH_COUNT; batch++)); do
    {
      if [[ "$WORKFLOW" == "pr" ]]; then
        print -- "Summarize this portion of a larger Git change for a final pull-request writer."
      else
        print -- "Summarize this portion of a larger Git change for a final commit-message writer."
      fi
      print -- "Do not inspect the repository, run commands, modify files, stage files, or commit."
      print -- "Identify intent and externally meaningful behavior across files; do not produce the final text."
      print -- "Return at most six concise bullets covering intent, behavior/contracts, tests, documentation, and material risks."
      print -- ""
      print -- "Repository: $REPO"
      print -- "Context mode: $CONTEXT_MODE"
      print -- "Batch: $batch of $BATCH_COUNT"
      print -- ""
      print -- "Diff portion:"
      cat "$TMP_DIR/batch-$batch.diff"
    } > "$TMP_DIR/batch-$batch.prompt"
  done
}

write_synthesis_prompt() {
  {
    if [[ "$WORKFLOW" == "pr" ]]; then
      print -- "Generate one pull request title and description from summaries of a large Git diff."
    else
      print -- "Generate one git commit message from summaries of a large Git diff."
    fi
    print -- "Do not inspect the repository yourself. Do not run commands. Do not modify files. Do not stage files. Do not commit."
    print -- "Synthesize the overall intent; summaries may overlap, so do not concatenate or mechanically enumerate them."
    print -- ""
    write_output_requirements
    print -- ""
    write_git_overview
    print -- ""
    print -- "Batch summaries:"
    local batch
    for ((batch = 1; batch <= BATCH_COUNT; batch++)); do
      print -- ""
      print -- "Summary $batch of $BATCH_COUNT:"
      cat "$TMP_DIR/batch-$batch.summary"
    done
  } > "$TMP_DIR/synthesis.prompt"
}

clean_message() {
  # Remove only an outer response fence. Markdown fences inside PR bodies
  # belong to the generated content and must remain intact.
  awk '
    { lines[NR]=$0; if ($0 ~ /[^[:space:]]/) { if (!first) first=NR; last=NR } }
    END {
      wrapped=(lines[first] ~ /^```[[:alnum:]_-]*$/ && lines[last] == "```" && first < last)
      for (i=1; i<=NR; i++) if (!wrapped || (i != first && i != last)) print lines[i]
    }
  ' "$MESSAGE_FILE" > "$MESSAGE_FILE.cleaned"
  mv "$MESSAGE_FILE.cleaned" "$MESSAGE_FILE"
}

set_progress() {
  local completed="$1"
  print -r -- "$completed" > "$PROGRESS_FILE"
}

start_progress() {
  if [[ "$VERBOSE" -eq 1 ]]; then
    return
  fi

  if [[ -t 1 ]]; then
    set_progress 0
    (
      local tick=0
      local completed
      local filled
      local remaining
      local marker
      local bar
      local position
      while true; do
        completed=0
        [[ -f "$PROGRESS_FILE" ]] && completed="$(<"$PROGRESS_FILE")"
        filled=$((completed * PROGRESS_WIDTH / PROGRESS_TOTAL))
        remaining=$((PROGRESS_WIDTH - filled))
        marker=0
        [[ "$remaining" -gt 0 ]] && marker=$((filled + tick % remaining + 1))
        bar=""
        for ((position = 1; position <= PROGRESS_WIDTH; position++)); do
          if [[ "$position" -le "$filled" ]]; then
            bar+="="
          elif [[ "$position" -eq "$marker" ]]; then
            bar+=">"
          else
            bar+="-"
          fi
        done
        print -n -- $'\r'"Generating $OUTPUT_NAME with $LABEL [$bar] $completed/$PROGRESS_TOTAL"
        tick=$((tick + 1))
        sleep 0.12
      done
    ) &
    PROGRESS_PID="$!"
  else
    print -- "Generating $OUTPUT_NAME with $LABEL..."
  fi
}

stop_progress() {
  local ok="$1"
  if [[ "$VERBOSE" -eq 1 ]]; then
    return
  fi

  if [[ -n "$PROGRESS_PID" ]]; then
    kill "$PROGRESS_PID" >/dev/null 2>&1 || true
    wait "$PROGRESS_PID" 2>/dev/null || true
    PROGRESS_PID=""
    if [[ "$ok" -eq 1 ]]; then
      local bar=""
      local position
      for ((position = 1; position <= PROGRESS_WIDTH; position++)); do bar+="="; done
      print -- $'\r'"Generated $OUTPUT_NAME with $LABEL [$bar] done"
    else
      print -- $'\r'"$LABEL failed while generating the $OUTPUT_NAME."
    fi
  fi
}

run_provider_once() {
  local prompt_file="$1"
  local message_file="$2"
  local model="$3"
  local reasoning_effort="$4"
  rm -f "$message_file"
  case "$PROVIDER" in
    codex)
      local -a args
      args=(
        exec
        -m "$model"
        --cd "$REPO"
        --sandbox read-only
        --ephemeral
      )
      if [[ -n "$reasoning_effort" ]]; then
        args+=(-c "model_reasoning_effort=$reasoning_effort")
      fi
      codex "${args[@]}" -o "$message_file" - < "$prompt_file"
      ;;
    claude)
      claude \
        --bare \
        -p \
        --model "$model" \
        --output-format text \
        "Use stdin as the full task. Follow its output instructions exactly." \
        < "$prompt_file" > "$message_file"
      ;;
    gemini)
      gemini \
        -p "Use stdin as the full task. Follow its output instructions exactly." \
        --model "$model" \
        < "$prompt_file" > "$message_file"
      ;;
  esac
}

provider_hit_usage_limit() {
  local provider_log="$1"
  case "$PROVIDER" in
    codex)
      LC_ALL=C grep -Fqi "ERROR: You've hit your usage limit for" "$provider_log"
      ;;
    claude)
      LC_ALL=C grep -Eqi 'usage limit|rate limit' "$provider_log"
      ;;
    gemini)
      LC_ALL=C grep -Eqi 'usage limit|rate limit|quota.*(exceeded|exhausted)|resource_exhausted' "$provider_log"
      ;;
  esac
}

run_provider() {
  local prompt_file="$1"
  local message_file="$2"
  local primary_log="$message_file.$PROVIDER-primary.log"
  local fallback_log="$message_file.$PROVIDER-fallback.log"
  local primary_status
  local fallback_status
  local primary_reasoning_effort=""
  local fallback_reasoning_effort=""

  if [[ "$PROVIDER" == "codex" ]]; then
    primary_reasoning_effort="$CODEX_REASONING_EFFORT"
  fi

  if run_provider_once \
    "$prompt_file" \
    "$message_file" \
    "$MODEL" \
    "$primary_reasoning_effort" \
    > "$primary_log" 2>&1; then
    cat "$primary_log"
    if [[ -s "$message_file" ]]; then
      return 0
    fi
    print -u2 -- "$LABEL completed without writing the $OUTPUT_NAME."
    return 1
  else
    primary_status=$?
  fi

  cat "$primary_log"
  if [[ -z "$FALLBACK_MODEL" || "$FALLBACK_MODEL" == "$MODEL" ]] || \
     ! provider_hit_usage_limit "$primary_log"; then
    return "$primary_status"
  fi

  if [[ "$PROVIDER" == "codex" ]]; then
    fallback_reasoning_effort="$CODEX_FALLBACK_REASONING_EFFORT"
  fi
  print -u2 -- "$LABEL model $MODEL reached its usage limit. Retrying with $FALLBACK_MODEL."
  if run_provider_once \
    "$prompt_file" \
    "$message_file" \
    "$FALLBACK_MODEL" \
    "$fallback_reasoning_effort" \
    > "$fallback_log" 2>&1; then
    fallback_status=0
  else
    fallback_status=$?
  fi
  cat "$fallback_log"
  if [[ "$fallback_status" -ne 0 ]]; then
    return "$fallback_status"
  fi
  if [[ ! -s "$message_file" ]]; then
    print -u2 -- "$LABEL fallback completed without writing the $OUTPUT_NAME."
    return 1
  fi

  print -r -- "$FALLBACK_MODEL" > "$FALLBACK_USED_FILE"
}

run_batched_provider() {
  local pids=()
  local batch
  for ((batch = 1; batch <= BATCH_COUNT; batch++)); do
    run_provider "$TMP_DIR/batch-$batch.prompt" "$TMP_DIR/batch-$batch.summary" > "$TMP_DIR/batch-$batch.log" 2>&1 &
    pids+=("$!")
  done

  local failed=0
  local index=1
  local pid
  for pid in "${pids[@]}"; do
    if ! wait "$pid"; then
      failed=1
    fi
    set_progress "$index"
    print -- "Batch $index provider log:"
    cat "$TMP_DIR/batch-$index.log"
    index=$((index + 1))
  done
  [[ "$failed" -eq 0 ]] || return 1

  write_synthesis_prompt
  local synthesis_bytes
  synthesis_bytes="$(wc -c < "$TMP_DIR/synthesis.prompt" | tr -d ' ')"
  if [[ "$synthesis_bytes" -gt "$MAX_PROMPT_BYTES" ]]; then
    print -u2 -- "Synthesis prompt exceeds ${PROVIDER:u}_MAX_PROMPT_BYTES ($synthesis_bytes > $MAX_PROMPT_BYTES)."
    return 1
  fi
  run_provider "$TMP_DIR/synthesis.prompt" "$MESSAGE_FILE" || return 1
  set_progress "$PROGRESS_TOTAL"
}

generate_message() {
  rm -f "$FALLBACK_USED_FILE"
  write_git_context

  local prompt_bytes
  prompt_bytes="$(wc -c < "$PROMPT_FILE" | tr -d ' ')"
  local batched=0
  local prompt_kib
  local file_word
  if [[ "$prompt_bytes" -gt "$MAX_PROMPT_BYTES" ]]; then
    build_batches
    write_batch_prompts
    batched=1
    prompt_kib=$(((prompt_bytes + 1023) / 1024))
    file_word="files"
    [[ "$BATCH_FILE_COUNT" -eq 1 ]] && file_word="file"
    print -- "Large change detected: $BATCH_FILE_COUNT $file_word, ${prompt_kib} KiB; analyzing in $BATCH_COUNT parallel batches."
  fi

  if [[ "$VERBOSE" -eq 1 ]]; then
    if [[ "$batched" -eq 1 ]]; then
      run_batched_provider
    else
      run_provider "$PROMPT_FILE" "$MESSAGE_FILE"
    fi
  else
    if [[ "$batched" -eq 1 ]]; then
      PROGRESS_TOTAL=$((BATCH_COUNT + 1))
    else
      PROGRESS_TOTAL=1
    fi
    start_progress
    if ! {
      if [[ "$batched" -eq 1 ]]; then
        run_batched_provider
      else
        run_provider "$PROMPT_FILE" "$MESSAGE_FILE" && set_progress 1
      fi
    } > "$LOG_FILE" 2>&1; then
      stop_progress 0
      print -u2 -- "$LABEL failed. Log: $LOG_FILE"
      return 1
    fi
    stop_progress 1
  fi

  if [[ -f "$FALLBACK_USED_FILE" ]]; then
    if [[ "$PROVIDER" == "codex" ]]; then
      print -- "Used $LABEL fallback model: $FALLBACK_MODEL (reasoning: $CODEX_FALLBACK_REASONING_EFFORT)"
    else
      print -- "Used $LABEL fallback model: $FALLBACK_MODEL"
    fi
  fi

  clean_message
}

show_message() {
  print -- ""
  print -- "Generated commit message:"
  print -- "-------------------------"
  cat "$MESSAGE_FILE"
  print -- ""
  print -- "-------------------------"
}

commit_message() {
  if [[ -z "$(git -C "$REPO" diff --cached --name-only)" ]]; then
    print -u2 -- "No staged changes to commit."
    print -u2 -- "Stage files with git add <file> and run quill again."
    return 1
  fi

  git -C "$REPO" commit -F "$MESSAGE_FILE"

  if [[ "$PUSH_AFTER_COMMIT" -eq 1 ]]; then
    push_commits
  fi
}

push_commits() {
  if ! git -C "$REPO" push; then
    print -u2 -- "Push failed. Commit remains local."
    return 1
  fi
}

prepare_message() {
  local editmsg
  editmsg="$(git -C "$REPO" rev-parse --path-format=absolute --git-path COMMIT_EDITMSG)"
  mkdir -p "$(dirname "$editmsg")"
  cp "$MESSAGE_FILE" "$editmsg"
  print -- "Prepared commit message at $editmsg"
}

copy_message() {
  local copied=0

  if command -v pbcopy >/dev/null 2>&1 && pbcopy < "$MESSAGE_FILE"; then
    copied=1
  elif command -v wl-copy >/dev/null 2>&1 && wl-copy < "$MESSAGE_FILE"; then
    copied=1
  elif command -v xclip >/dev/null 2>&1 && xclip -selection clipboard < "$MESSAGE_FILE"; then
    copied=1
  elif command -v xsel >/dev/null 2>&1 && xsel --clipboard --input < "$MESSAGE_FILE"; then
    copied=1
  fi

  if [[ "$copied" -ne 1 ]]; then
    print -u2 -- "No clipboard command succeeded. Tried pbcopy, wl-copy, xclip, and xsel."
    return 1
  fi

  print -- "Copied commit message to clipboard"
}

prepare_pull_request() {
  PR_BODY_FILE="$TMP_DIR/pr-body.md"

  PR_TITLE="$(awk 'NF { print; exit }' "$MESSAGE_FILE")"
  awk '!title_seen && NF { title_seen=1; next } title_seen && (body_seen || NF) { body_seen=1; print }' "$MESSAGE_FILE" > "$PR_BODY_FILE"
  if [[ -z "$PR_TITLE" ]]; then
    print -u2 -- "$LABEL did not generate a pull request title."
    return 1
  fi
  if [[ ! -s "$PR_BODY_FILE" ]]; then
    print -u2 -- "$LABEL did not generate a pull request description."
    return 1
  fi

  PR_PREVIEW_FILE="$TMP_DIR/pr-preview.txt"
  {
    print -r -- "From: $PR_HEAD_BRANCH"
    print -r -- "Into: $PR_BASE_REPO:$PR_BASE_BRANCH"
    print -- ""
    print -r -- "$PR_TITLE"
    print -- ""
    cat "$PR_BODY_FILE"
  } > "$PR_PREVIEW_FILE"
}

preview_pull_request() {
  local choice result
  # Pass the file through the environment; never put PR content in shell code.
  if choice="$(print -r -- 'Create pull request' | \
    QUILL_PR_PREVIEW="$PR_PREVIEW_FILE" tui_fzf \
    --border-label=' Quillmit | Review pull request ' \
    --no-input --info=hidden \
    --header=$'Enter: create PR | Esc: choose another branch | Ctrl-C: cancel\nUp/Down, PgUp/PgDn or mouse wheel: scroll preview' \
    --preview='cat -- "$QUILL_PR_PREVIEW"' --preview-window='up,80%,wrap' \
    --expect=esc,ctrl-c,ctrl-g \
    --bind='double-click:ignore,up:preview-up,down:preview-down,pgup:preview-page-up,pgdn:preview-page-down,home:preview-top,end:preview-bottom')"; then
    case "${choice%%$'\n'*}" in
      '') return 0 ;;
      esc) return 1 ;;
      *) print -- "Pull request cancelled."; exit 0 ;;
    esac
  else
    result=$?
    if [[ "$result" -eq 130 ]]; then
      print -- "Pull request cancelled."
      exit 0
    fi
    print -u2 -- "Pull request preview failed (exit $result)."
    exit "$result"
  fi
}

create_pull_request() {
  print -- "Creating pull request from $PR_HEAD_BRANCH into $PR_BASE_REPO:$PR_BASE_BRANCH..."
  (cd "$REPO" && gh pr create \
    --repo "$PR_BASE_URL" \
    --base "$PR_BASE_BRANCH" \
    --assignee "@me" \
    --title "$PR_TITLE" \
    --body-file "$PR_BODY_FILE")
}

if [[ "$WORKFLOW" == worktree ]]; then
  source "$SCRIPT_DIR/scripts/worktree"
  worktree_main
  exit 0
fi

if [[ "$WORKFLOW" == "pr" ]]; then
  while true; do
    generate_message
    prepare_pull_request
    if [[ "$PR_NO_PREVIEW" -eq 1 ]] || preview_pull_request; then
      create_pull_request
      exit 0
    fi
    PR_BASE_INPUT=""
    setup_pr_context
  done
fi

generate_message

show_message

if [[ "$MODE" == "interactive" ]]; then
  prepare_message
fi

case "$MODE" in
  prepare)
    prepare_message
    exit 0
    ;;
  commit)
    commit_message
    exit 0
    ;;
  copy)
    prepare_message
    copy_message
    exit 0
    ;;
  quit)
    print -- "Quit without preparing or committing"
    exit 0
    ;;
esac

while true; do
  print -n -- "[c]ommit, [e]dit, co[p]y, [r]egenerate, [q]uit: "
  read -r choice

  case "${choice:l}" in
    c|commit)
      commit_message
      exit 0
      ;;
    e|edit)
      "${EDITOR:-vi}" "$MESSAGE_FILE"
      show_message
      ;;
    p|copy)
      copy_message
      ;;
    r|regenerate)
      generate_message
      show_message
      ;;
    q|quit|"")
      print -- "Quit without committing"
      exit 0
      ;;
    *)
      print -- "Choose c, e, p, r, or q."
      ;;
  esac
done
