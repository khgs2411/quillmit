#!/bin/zsh
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERSION_FILE="$ROOT/VERSION"
BUMP="patch"
BUMP_SELECTED=0

usage() {
  cat <<'TEXT'
Usage: scripts/version [--patch|--minor|--major]

Increment Quillmit's semantic VERSION. Defaults to --patch.
TEXT
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --patch|--minor|--major)
      if [[ "$BUMP_SELECTED" -eq 1 ]]; then
        print -u2 -- "Choose exactly one of --patch, --minor, or --major."
        exit 1
      fi
      BUMP="${1#--}"
      BUMP_SELECTED=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      print -u2 -- "Unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

if [[ ! -f "$VERSION_FILE" ]]; then
  print -u2 -- "Missing version file: $VERSION_FILE"
  exit 1
fi

current="$(tr -d '[:space:]' < "$VERSION_FILE")"
if [[ ! "$current" =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]]; then
  print -u2 -- "VERSION must contain a stable semantic version (major.minor.patch): $current"
  exit 1
fi

parts=("${(@s:.:)current}")
major="${parts[1]}"
minor="${parts[2]}"
patch="${parts[3]}"

case "$BUMP" in
  patch) patch=$((patch + 1)) ;;
  minor)
    minor=$((minor + 1))
    patch=0
    ;;
  major)
    major=$((major + 1))
    minor=0
    patch=0
    ;;
esac

next="$major.$minor.$patch"
temporary="$VERSION_FILE.tmp-$$"
trap 'rm -f "$temporary"' EXIT
print -r -- "$next" > "$temporary"
mv "$temporary" "$VERSION_FILE"

print -- "Bumped Quillmit version: $current -> $next ($BUMP)"
