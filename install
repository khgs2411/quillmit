#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$HOME/.local/bin"
INSTALL_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/quillmit"
VERSION="$(tr -d '[:space:]' < "$SCRIPT_DIR/VERSION")"
AGENT_GUIDE=""

usage() {
  cat <<'TEXT'
Usage: install [--bin-dir dir] [--install-root dir] [--agent-guide|--no-agent-guide]

Install the current Quillmit version as a copied, versioned package.
Link the Agent Guide into existing global instructions by default.
--no-agent-guide removes it and remembers the opt-out; --agent-guide opts back in.
TEXT
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bin-dir)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || { print -u2 -- "--bin-dir requires a directory."; exit 1; }
      BIN_DIR="$2"
      shift 2
      ;;
    --install-root)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || { print -u2 -- "--install-root requires a directory."; exit 1; }
      INSTALL_ROOT="$2"
      shift 2
      ;;
    --agent-guide|--no-agent-guide)
      if [[ -n "$AGENT_GUIDE" && "$AGENT_GUIDE" != "$1" ]]; then
        print -u2 -- "--agent-guide and --no-agent-guide are mutually exclusive."
        exit 1
      fi
      AGENT_GUIDE="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      print -u2 -- "Unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

if [[ -z "$BIN_DIR" ]]; then
  print -u2 -- "--bin-dir cannot be empty"
  exit 1
fi
if [[ -z "$INSTALL_ROOT" ]]; then
  print -u2 -- "--install-root cannot be empty"
  exit 1
fi
if [[ -z "$VERSION" || "$VERSION" == *[!0-9A-Za-z._-]* ]]; then
  print -u2 -- "Invalid VERSION: $VERSION"
  exit 1
fi

for source_file in quill quill.config QUILLMIT.md VERSION scripts/setup-deps scripts/worktree scripts/filter-diff.py scripts/run-provider.py scripts/parse-pr-draft.py third-party/fzf.lock third-party/fzf.LICENSE; do
  if [[ ! -f "$SCRIPT_DIR/$source_file" ]]; then
    print -u2 -- "Missing install source: $SCRIPT_DIR/$source_file"
    exit 1
  fi
done

# Resolve relative paths once so the launcher works from any directory.
BIN_DIR="${BIN_DIR:A}"
INSTALL_ROOT="${INSTALL_ROOT:A}"
LAUNCHER_PATH="$BIN_DIR/quill"
if [[ -L "$LAUNCHER_PATH" ]]; then
  current_target="$(readlink "$LAUNCHER_PATH")"
  resolved_target="$current_target"
  [[ "$resolved_target" == /* ]] || resolved_target="$BIN_DIR/$resolved_target"
  case "${resolved_target:A}" in
    "${SCRIPT_DIR:A}/quill"|*"/Repositories/codex-gcommit/"*|*"/Repositories/quill/"*|*"/Repositories/quillmit/"*)
      :
      ;;
    *)
      print -u2 -- "Refusing to replace unowned quill symlink: $LAUNCHER_PATH -> $current_target"
      exit 1
      ;;
  esac
elif [[ -e "$LAUNCHER_PATH" ]] && ! grep -q '^# Quillmit installed launcher$' "$LAUNCHER_PATH"; then
  print -u2 -- "Refusing to replace unowned command: $LAUNCHER_PATH"
  exit 1
fi

VERSION_DIR="$INSTALL_ROOT/versions/$VERSION"
STAGING_DIR="$INSTALL_ROOT/.install-$VERSION-$$"
launcher_tmp="$LAUNCHER_PATH.tmp-$$"
guide_tmp=""
trap 'rm -rf "$STAGING_DIR"; rm -f "$launcher_tmp"; [[ -z "$guide_tmp" ]] || rm -f "$guide_tmp"' EXIT

mkdir -p "$BIN_DIR" "$INSTALL_ROOT/versions"

mkdir "$STAGING_DIR"
mkdir "$STAGING_DIR/scripts"
cp "$SCRIPT_DIR/scripts/worktree" "$STAGING_DIR/scripts/worktree"
cp "$SCRIPT_DIR/scripts/filter-diff.py" "$SCRIPT_DIR/scripts/run-provider.py" "$SCRIPT_DIR/scripts/parse-pr-draft.py" "$STAGING_DIR/scripts/"
cp "$SCRIPT_DIR/quill" "$STAGING_DIR/quill"
cp "$SCRIPT_DIR/quill.config" "$STAGING_DIR/quill.config"
cp "$SCRIPT_DIR/QUILLMIT.md" "$STAGING_DIR/QUILLMIT.md"
cp "$SCRIPT_DIR/VERSION" "$STAGING_DIR/VERSION"
chmod 755 "$STAGING_DIR/quill"
zsh "$SCRIPT_DIR/scripts/setup-deps" "$STAGING_DIR/.deps/fzf"

if [[ -L "$VERSION_DIR" ]]; then
  print -u2 -- "Refusing a symlink at the version directory: $VERSION_DIR"
  exit 1
fi

if [[ -e "$VERSION_DIR" ]]; then
  if [[ ! -f "$VERSION_DIR/quill" || ! -f "$VERSION_DIR/quill.config" || ! -f "$VERSION_DIR/VERSION" ]] || \
     ! cmp -s "$SCRIPT_DIR/quill" "$VERSION_DIR/quill" || \
     ! cmp -s "$SCRIPT_DIR/quill.config" "$VERSION_DIR/quill.config" || \
     ! cmp -s "$SCRIPT_DIR/QUILLMIT.md" "$VERSION_DIR/QUILLMIT.md" || \
     ! cmp -s "$SCRIPT_DIR/VERSION" "$VERSION_DIR/VERSION" || \
     ! cmp -s "$SCRIPT_DIR/scripts/worktree" "$VERSION_DIR/scripts/worktree" || \
     ! cmp -s "$SCRIPT_DIR/scripts/filter-diff.py" "$VERSION_DIR/scripts/filter-diff.py" || \
     ! cmp -s "$SCRIPT_DIR/scripts/run-provider.py" "$VERSION_DIR/scripts/run-provider.py" || \
     ! cmp -s "$SCRIPT_DIR/scripts/parse-pr-draft.py" "$VERSION_DIR/scripts/parse-pr-draft.py" || \
     ! diff -rq "$STAGING_DIR/.deps/fzf" "$VERSION_DIR/.deps/fzf" >/dev/null 2>&1; then
    print -u2 -- "Quillmit $VERSION is already installed with different contents. Bump VERSION before installing changed release bytes."
    exit 1
  fi
else
  mv "$STAGING_DIR" "$VERSION_DIR"
fi

if [[ -L "$BIN_DIR/gcommit" ]]; then
  legacy_target="$(readlink "$BIN_DIR/gcommit")"
  [[ "$legacy_target" == /* ]] || legacy_target="$BIN_DIR/$legacy_target"
  case "${legacy_target:A}" in
    "${SCRIPT_DIR:A}/gcommit"|*"/Repositories/codex-gcommit/"*|*"/Repositories/quill/"*|*"/Repositories/quillmit/"*)
      rm "$BIN_DIR/gcommit"
      print -- "Removed legacy gcommit -> $BIN_DIR/gcommit"
      ;;
    *) print -u2 -- "Preserved unrecognized gcommit symlink: $BIN_DIR/gcommit" ;;
  esac
fi
if [[ -L "$LAUNCHER_PATH" ]]; then
  print -- "Removed legacy quill symlink -> $current_target"
fi

target_quoted="$(printf '%q' "$VERSION_DIR/quill")"
{
  print -r -- '#!/bin/zsh'
  print -r -- '# Quillmit installed launcher'
  print -r -- "# Version: $VERSION"
  print -r -- 'set -euo pipefail'
  print -r -- "exec $target_quoted \"\$@\""
} > "$launcher_tmp"
chmod 755 "$launcher_tmp"
mv -f "$launcher_tmp" "$LAUNCHER_PATH"

for installed_dir in "$INSTALL_ROOT/versions"/*(N); do
  [[ "$installed_dir" == "$VERSION_DIR" ]] && continue

  if [[ -L "$installed_dir" || ! -d "$installed_dir" || \
        ! -f "$installed_dir/quill" || ! -f "$installed_dir/quill.config" || ! -f "$installed_dir/VERSION" ]]; then
    print -u2 -- "Preserved unrecognized install artifact: $installed_dir"
    continue
  fi

  installed_version="$(tr -d '[:space:]' < "$installed_dir/VERSION")"
  if [[ "$installed_version" != "${installed_dir:t}" || "$installed_version" == *[!0-9A-Za-z._-]* ]]; then
    print -u2 -- "Preserved unrecognized install artifact: $installed_dir"
    continue
  fi

  rm -rf -- "$installed_dir"
  print -- "Removed Quillmit $installed_version -> $installed_dir"
done

guide_opt_out="$INSTALL_ROOT/agent-guide-disabled"
for instructions in "$HOME/.claude/CLAUDE.md" "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"; do
  if [[ "${QUILLMIT_SKIP_AGENT_GUIDE:-}" == 1 ]]; then
    print -- "Agent Guide skipped (this run): $instructions"
    continue
  fi
  if [[ -z "$AGENT_GUIDE" && -e "$guide_opt_out" ]]; then
    print -- "Agent Guide skipped (opted out): $instructions"
    continue
  fi
  if [[ ! -f "$instructions" ]]; then
    print -- "Agent Guide skipped (file absent): $instructions"
    continue
  fi
  guide_link='@QUILLMIT.md'
  if [[ "$instructions" == "${CODEX_HOME:-$HOME/.codex}/AGENTS.md" ]]; then
    guide_link="@${instructions:h}/QUILLMIT.md"
    [[ "$instructions" == /* ]] || guide_link="@$PWD/${instructions:h}/QUILLMIT.md"
  fi
  guide_found=0
  guide_tmp="$(mktemp "${TMPDIR:-/tmp}/quill-agent-guide.XXXXXX")"
  # Match owned links literally; paths may contain spaces or regex characters.
  # Preserve surrounding content, line endings and a missing final newline.
  {
    while true; do
      guide_newline=1
      IFS= read -r guide_line || guide_newline=0
      [[ "$guide_newline" == 1 || -n "$guide_line" ]] || break
      guide_text="${guide_line%"${guide_line##*[![:space:]]}"}"
      if [[ "$guide_text" == '@QUILLMIT.md' || "$guide_text" == "$guide_link" ]]; then
        guide_found=1
        [[ "$AGENT_GUIDE" == --no-agent-guide ]] && continue
        guide_line="$guide_link${guide_line#"$guide_text"}"
      fi
      printf '%s' "$guide_line"
      [[ "$guide_newline" == 0 ]] || printf '\n'
    done
  } < "$instructions" > "$guide_tmp"
  if [[ "$guide_found" == 1 ]]; then
    cat "$guide_tmp" > "$instructions"
  fi
  rm "$guide_tmp"
  guide_tmp=""
  if [[ "$AGENT_GUIDE" == --no-agent-guide ]]; then
    rm -f "${instructions:h}/QUILLMIT.md"
    print -- "Agent Guide removed: $instructions"
    continue
  fi
  cp "$VERSION_DIR/QUILLMIT.md" "${instructions:h}/QUILLMIT.md"
  if [[ "$guide_found" == 1 ]]; then
    print -- "Agent Guide refreshed: $instructions"
  else
    # Terminate an existing last line before adding the separating blank line.
    if [[ -s "$instructions" && -n "$(tail -c 1 "$instructions")" ]]; then
      print >> "$instructions"
    fi
    printf '\n%s\n' "$guide_link" >> "$instructions"
    print -- "Agent Guide linked: $instructions"
  fi
  if [[ "$instructions" == "${CODEX_HOME:-$HOME/.codex}/AGENTS.md" ]]; then
    codex_override="${instructions:h}/AGENTS.override.md"
    if [[ -f "$codex_override" ]] && LC_ALL=C grep -q '[^[:space:]]' "$codex_override"; then
      print -u2 -- "Warning: Codex ignores AGENTS.md and the Agent Guide while $codex_override is non-blank."
    fi
  fi
done

if [[ "${QUILLMIT_SKIP_AGENT_GUIDE:-}" != 1 ]]; then
  case "$AGENT_GUIDE" in
    --no-agent-guide) touch "$guide_opt_out" ;;
    --agent-guide) rm -f "$guide_opt_out" ;;
  esac
fi
case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) print -u2 -- "$BIN_DIR is not on PATH. Add it to your shell PATH before invoking quill globally." ;;
esac

print -- "Installed Quillmit $VERSION -> $VERSION_DIR"
print -- "Installed quill launcher -> $LAUNCHER_PATH"
